    "/v1/ws/voice": {
      "description": "Потоковый голосовой диалог по WebSocket.\n\nКлиент отправляет бинарные кадры PCM16 16 kHz mono (20–100 мс на кадр) и текстовый\nкадр `{\"type\":\"end\"}` для завершения реплики. Сервер отдаёт события JSON в текстовых\nкадрах, аудио-ответ — чанками base64. Авторизация: `?token=<API_KEY>`.",
      "parameters": [
        {
          "name": "session_id",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Идентификатор сессии диалога (device_id для колонки)."
        },
        {
          "name": "token",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "API-ключ приложения."
        }
      ],
      "x-websocket": {
        "protocol": "ws",
        "subprotocol": null,
        "client_messages": [
          {
            "type": "binary",
            "content": "PCM16 16 kHz mono, base64 не нужен (сырые байты).",
            "example": "<20-100 мс аудио>"
          },
          {
            "type": "text",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "end",
                    "cancel"
                  ]
                },
                "confirm_token": {
                  "type": "string",
                  "description": "Токен из события action_draft предыдущего turn."
                }
              },
              "required": [
                "type"
              ]
            },
            "example": {
              "type": "end",
              "confirm_token": "..."
            }
          }
        ],
        "server_events": [
          {
            "type": "status",
            "stage": "listening|transcribing|thinking|tool|speaking|cancelled"
          },
          {
            "type": "transcript",
            "text": "string",
            "final": true
          },
          {
            "type": "delta",
            "text": "string"
          },
          {
            "type": "action_draft",
            "draft": {
              "id": "draft_...",
              "channel": "email|max",
              "recipient": "Мама",
              "text": "...",
              "confirm_token": "...",
              "expires_at": "2026-11-25T12:00:00"
            }
          },
          {
            "type": "audio",
            "data": "<base64 audio>",
            "index": 0
          },
          {
            "type": "answer",
            "text": "string",
            "sources": []
          },
          {
            "type": "done",
            "turn_id": "turn_..."
          },
          {
            "type": "error",
            "message": "string"
          }
        ]
      }
    }
  },
