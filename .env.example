# --- Core ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_PII=false
API_KEYS=dev-key
DATABASE_URL=sqlite+aiosqlite:///./data/assistant.db
CORS_ORIGINS=*

# --- LLM: OpenAI-совместимая цепочка (первый доступный побеждает) ---
# type: openai | mock. По умолчанию mock, чтобы стартовать без ключей.
LLM_PROVIDERS=[{"name":"mock","type":"mock","model":"mock-llm"}]
# Пример для GPU-профиля (см. docker-compose.gpu.yml):
# LLM_PROVIDERS=[{"name":"local","type":"openai","base_url":"http://llm:8080/v1","api_key":"local","model":"qwen2.5-3b-instruct","timeout":25,"temperature":0.3},{"name":"cloud","type":"openai","base_url":"https://openrouter.ai/api/v1","api_key":"sk-REPLACE_ME","model":"openai/gpt-4o-mini","timeout":30,"temperature":0.3}]
LLM_MOCK_MODE=smart
LLM_MAX_TOOL_ROUNDS=3

# --- STT / TTS: OpenAI-совместимый контракт ---
STT_TYPE=openai
STT_BASE_URL=http://voice:8001/v1
STT_API_KEY=local
STT_MODEL=small
STT_LANGUAGE=ru
STT_TIMEOUT=60
STT_MOCK_TEXT="Сколько по времени варить макароны?"
TTS_TYPE=openai
TTS_BASE_URL=http://voice:8001/v1
TTS_API_KEY=local
TTS_MODEL=ru_RU-irina-medium
TTS_VOICE=ru_RU-irina-medium
TTS_FORMAT=mp3
TTS_TIMEOUT=60

# --- Search: tavily | brave | serper | searxng | mock ---
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_BASE_URL=http://searxng:8080
SEARCH_TIMEOUT=15
SEARCH_MAX_RESULTS=4

# --- MAX: mock | bot | user_bridge | disabled ---
MAX_TRANSPORT=mock
MAX_API_BASE=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=change-me
MAX_BOT_RATE_LIMIT_PER_SEC=2
# Адрес собственного companion-приложения, хранящего сессию пользователя MAX
MAX_USER_BRIDGE_URL=http://max-bridge:9000
MAX_USER_BRIDGE_TOKEN=

# --- Email: mock | smtp ---
EMAIL_TRANSPORT=mock
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=assistant@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT=15

# --- Contacts allowlist (модель не может придумать получателя) ---
CONTACTS_JSON={"мама":{"channel":"email","recipient":"mama@example.com","name":"Мама"},"ребенок":{"channel":"max","recipient":"1000000000","name":"Ребёнок"}}
REQUIRE_CONTACT_ALLOWLIST=true

# --- Safety ---
CONFIRMATION_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=30
MAX_AUDIO_BYTES=25000000

# --- voice-gateway (локальные STT/TTS) ---
STT_BACKEND=dummy
STT_MODEL_SIZE=small
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_IDLE_UNLOAD_SECONDS=120
TTS_BACKEND=dummy
PIPER_MODEL_PATH=/models/piper/ru_RU-irina-medium.onnx
PIPER_CONFIG_PATH=
